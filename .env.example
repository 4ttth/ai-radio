# ─────────────────────────────────────────────────────────────
#  AI Radio — environment configuration
#  Copy this file to ".env" and fill in your own values.
#  ".env" is git-ignored: your key never gets committed.
# ─────────────────────────────────────────────────────────────

# Your Google Gemini API key (from https://aistudio.google.com/apikey).
# A valid key looks like "AIzaSy...".
GEMINI_API_KEY=your-gemini-api-key-here

# Models — leave BLANK to auto-detect the best models your key has access to
# (recommended; model names change over time). Set one only to force a specific
# model, e.g. GEMINI_TEXT_MODEL=gemini-flash-latest, GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TEXT_MODEL=
GEMINI_TTS_MODEL=

# Optional native-audio (Live API) model, used only when the DJ "Voice engine"
# is set to Native audio in the app. Blank = auto-detect (e.g. gemini-2.5-flash-native-audio-latest).
GEMINI_NATIVE_MODEL=

# ── Local text generation via Ollama (optional — runs offline, no key) ──
# Set OLLAMA_URL and the DJ/news scripts are written by your local model
# instead of Gemini. Combined with the Kokoro voice engine below, the whole
# station runs offline with no API key at all.
#   1. Install Ollama (https://ollama.com), then:  ollama pull phi4-mini
#   2. Make sure it's running:                     ollama serve
# Leave OLLAMA_URL blank to use Gemini for scripts.
# Ollama's default address is http://127.0.0.1:11434
OLLAMA_URL=
OLLAMA_MODEL=phi4-mini

# ── Local Kokoro TTS (optional voice engine — runs offline on CPU, no key) ──
# Used only when the DJ "Voice engine" is set to "Local · Kokoro". Model files
# download once (~80MB for q8) into data/models/. Defaults are usually fine.
KOKORO_MODEL=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_DTYPE=q8
KOKORO_DEVICE=cpu
KOKORO_DEFAULT_VOICE=af_heart

# Be gentle with the free tier: max Gemini requests per minute.
# The app spaces calls out to stay under this. Raise it on a paid key.
GEMINI_MAX_RPM=8

# Absolute path to the folder of music you want to stream.
# You can also set this later from the web UI.
MUSIC_FOLDER=

# Server
PORT=4123
HOST=127.0.0.1
